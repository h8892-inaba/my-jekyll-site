ntation\u0026body=https://www.slideshare.net/slideshow/160608-01/62877975","extension":"pdf","facebookShareUrl":"https://facebook.com/sharer.php?u=https%3A%2F%2Fwww.slideshare.net%2Fslideshow%2F160608-01%2F62877975\u0026t=160608+01","wordpressShareUrl":"[slideshare id=62877975\u0026doc=160608-01-160609024216]","formats":["pdf"],"genaiDescriptionCreatedAt":null,"genaiTest":"control","id":"62877975","isConverted":false,"isEmbedAllowed":true,"iframeEmbed":{"url":"https://www.slideshare.net/slideshow/embed_code/key/MoPJFOi8vJgEVf","height":486,"width":597},"isIndexable":false,"isLikedByCurrentUser":false,"isPrivate":false,"isViewable":true,"language":"ja","likes":1,"linkedinShareUrl":"https://www.linkedin.com/cws/share?url=https%3A%2F%2Fwww.slideshare.net%2Fslideshow%2F160608-01%2F62877975\u0026trk=SLIDESHARE","downloadCount":9,"secretUrl":"MoPJFOi8vJgEVf","shouldShowAds":false,"slides":{"host":"https://image.slidesharecdn.com","title":"160608-01","imageLocation":"160608-01-160609024216","imageSizes":[{"quality":85,"width":320,"format":"jpg"},{"quality":85,"width":638,"format":"jpg"},{"quality":75,"width":2048,"format":"webp"}]},"smsShareUrl":"sms:?body=Check out this presentation : https://www.slideshare.net/slideshow/160608-01/62877975","strippedTitle":"160608-01","thumbnail":"https://cdn.slidesharecdn.com/ss_thumbnails/160608-01-160609024216-thumbnail.jpg?width=640\u0026height=640\u0026fit=bounds","title":"160608 01","totalSlides":69,"transcript":["インターネットを利⽤したロボットサービスと\nRSiの取り組み2016\n2016年6⽉8⽇\n産業技術⼤学院⼤学\n成⽥雅彦\n1\nROBOMEC2016\nインターネットを利用したロボット\nサービス基盤としてのRSNP講習会\t\nCopyright © 2016 Masahiko Narita ALL Right reserved\n ","本⽇の内容\n!  ロボットソフトウェアプラットフォームの動向を概観\n!  RSiの活動とRSNP\n!  RSNPにより実現されているロボットサービス/成果の紹介\n2\nROBOMEC2016\nインターネットを利用したロボット\nサービス基盤としてのRSNP講習会\t\nCopyright © 2016 Masahiko Narita ALL Right reserved\n ","ロボットと周辺の動向\n!  ロボット向けソフトウェア基盤の活発化\nRTM, RSi (2004〜 ⽇本），ROS(2008〜 アメリカ）\n!  ロボット要素技術のオープン化\n!  ネットワーク／インターネットとの連携(2010〜 アメリカ）\n!  ロボットの低価格化・⼩型化が加速(2012〜）\n